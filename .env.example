# Copy to .env and replace every placeholder. Nothing here is a real credential.
DATABASE_URL=postgres://meterly:replace-me@localhost:5432/meterly
STRIPE_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
PORT=3000
LOG_LEVEL=info

# Optional tuning (defaults shown)
WEBHOOK_TOLERANCE_SECONDS=300
MAX_EVENT_AGE_DAYS=35
MAX_CLOCK_SKEW_SECONDS=300
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=60
DB_POOL_SIZE=10

# Tests only: must point at a database whose name ends in _test (it is created if missing).
TEST_DATABASE_URL=postgres://meterly:replace-me@localhost:5432/meterly_test
